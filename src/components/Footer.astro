---
import { WHATSAPP, INSTAGRAM } from '../consts';
---
<footer class="footer">
  <div class="container footer-inner">
    <img src="/images/nuecery-logo.png" alt="Nuecery" width="48" height="48" />
    <p>&copy; {new Date().getFullYear()} Nuecery Cuauhtémoc. Todos los derechos reservados.</p>
    <div class="social">
      <a href={INSTAGRAM} target="_blank" rel="noopener" aria-label="Instagram"><i class="fab fa-instagram" aria-hidden="true"></i></a>
      <a href={WHATSAPP} target="_blank" rel="noopener" aria-label="WhatsApp"><i class="fab fa-whatsapp" aria-hidden="true"></i></a>
    </div>
  </div>
</footer>

<style>
  .footer { padding-block: 1.75rem; }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.25rem;
  }

  img { border-radius: 50%; }

  p {
    font-size: 0.9rem;
    color: var(--ciruela-suave);
  }

  .social {
    display: flex;
    gap: 1.25rem;
    margin-left: auto;
    font-size: 1.5rem;
  }

  .social a:hover { color: var(--terracota-oscuro); }
</style>
