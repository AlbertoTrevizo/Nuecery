---
import { WHATSAPP, INSTAGRAM } from '../consts';

const steps = [
  { title: 'Elige tu nuez', text: 'Corazón, pedacería, granillo, granzón o garapiñada, en 1 kg o 500 gr.' },
  { title: 'Escríbenos', text: 'Mándanos un WhatsApp con tu pedido o un mensaje por Instagram.' },
  { title: 'Recibe tu nuez', text: 'Te confirmamos el pedido y acordamos cómo entregártelo.' }
];
---

<section id="contacto" class="section contact">
  <div class="container">
    <div class="section-head">
      <h2>Haz tu pedido</h2>
      <p>¿Tienes alguna pregunta o quieres pedir? Escríbenos, te respondemos por WhatsApp o Instagram.</p>
    </div>
    <ol class="steps">
      {steps.map((step, i) => (
        <li>
          <span class="step-number" aria-hidden="true">{i + 1}</span>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </li>
      ))}
    </ol>
    <div class="contact-actions">
      <a href={WHATSAPP} class="btn btn-light" target="_blank" rel="noopener">
        <i class="fab fa-whatsapp" aria-hidden="true"></i> Escribir por WhatsApp
      </a>
      <a href={INSTAGRAM} class="btn btn-ghost" target="_blank" rel="noopener">
        <i class="fab fa-instagram" aria-hidden="true"></i> Ver Instagram
      </a>
    </div>
  </div>
</section>

<style>
  .contact {
    background: var(--ciruela);
    color: var(--crema);
  }

  .section-head p { color: var(--rosa); }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
    max-width: 960px;
    margin: 0 auto 3.5rem;
    padding: 0;
    list-style: none;
  }

  .step-number {
    display: block;
    font-family: var(--display);
    font-size: 4rem;
    line-height: 1;
    color: var(--caramelo);
  }

  h3 {
    margin: 0.5rem 0;
    font-size: 1.5rem;
  }

  .steps p { color: var(--rosa); }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }

  .btn-light {
    background: var(--rosa);
    border-color: var(--rosa);
    color: var(--ciruela);
  }

  .btn-light:hover {
    background: var(--crema);
    border-color: var(--crema);
  }

  .btn-ghost {
    background: transparent;
    border-color: var(--rosa);
    color: var(--crema);
  }

  .btn-ghost:hover {
    background: var(--crema);
    border-color: var(--crema);
    color: var(--ciruela);
  }

  :focus-visible { outline-color: var(--caramelo); }

  @media (max-width: 760px) {
    .steps { grid-template-columns: 1fr; gap: 2rem; }
  }
</style>
