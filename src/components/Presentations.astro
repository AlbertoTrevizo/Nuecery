---
import ProductCard from './ProductCard.astro';
import corazon from '../assets/images/nuez-corazon.jpg';
import pedaceria from '../assets/images/nuez-pedaceria.jpg';
import granillo from '../assets/images/nuez-granillo.jpg';
import granzon from '../assets/images/nuez-granzon.jpg';
import garapinada from '../assets/images/nuez-garapinada.jpg';

const products = [
  { name: 'Nuez Corazón', image: corazon, description: 'Mitades enteras, para botanear o decorar postres.' },
  { name: 'Nuez Pedacería', image: pedaceria, description: 'Trozos grandes para pays, ensaladas y galletas.' },
  { name: 'Nuez Granillo', image: granillo, description: 'Picada mediana, lista para pasteles y panes.' },
  { name: 'Nuez Granzón', image: granzon, description: 'Picada fina para rellenos, empanizados y masas.' },
  { name: 'Nuez Garapiñada', image: garapinada, description: 'Cubierta de caramelo crujiente, lista para comer.' }
];
---

<section id="presentaciones" class="section">
  <div class="container">
    <div class="section-head">
      <h2>Nuestras presentaciones</h2>
      <p>Cinco cortes de nuez pecana, cada uno en bolsa de 1 kg o 500 gr.</p>
    </div>
    <div class="products">
      {products.map(product => <ProductCard {...product} presentaciones={['1 kg', '500 gr']} />)}
    </div>
  </div>
</section>

<style>
  .products {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.75rem;
  }
</style>
