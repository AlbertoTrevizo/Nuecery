---
import { Image } from 'astro:assets';

const { name, address, mapImage, mapLink } = Astro.props;
---

<article class="location-card">
  <Image src={mapImage} alt={`Foto de ${name}`} width={720} widths={[360, 720]} sizes="(max-width: 640px) 100vw, 360px" />
  <div class="info">
    <h3>{name}</h3>
    <p>{address}</p>
    <a href={mapLink} target="_blank" rel="noopener">
      <i class="fas fa-map-marker-alt" aria-hidden="true"></i> Cómo llegar
    </a>
  </div>
</article>

<style>
  .location-card {
    display: flex;
    flex-direction: column;
    background: var(--crema);
    border-radius: 20px;
    overflow: hidden;
  }

  img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .info {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    padding: 1.25rem 1.5rem 1.5rem;
  }

  h3 { font-size: 1.4rem; }

  p { color: var(--ciruela-suave); }

  a {
    margin-top: auto;
    padding-top: 0.5rem;
    color: var(--terracota-oscuro);
    font-weight: 700;
    text-underline-offset: 4px;
  }

  a:hover { color: var(--ciruela); }
</style>
