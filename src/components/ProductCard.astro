---
import { Image } from 'astro:assets';
import { WHATSAPP } from '../consts';

const { name, image, description, presentaciones } = Astro.props;
const orderLink = `${WHATSAPP}?text=${encodeURIComponent(`Hola, me interesa la ${name}.`)}`;
---

<article class="product-card">
  <Image src={image} alt={`Bolsas de ${name} de Nuecery`} width={720} widths={[360, 720]} sizes="340px" class="product-image" />
  <div class="product-details">
    <h3>{name}</h3>
    <p>{description}</p>
    <ul class="sizes" aria-label="Presentaciones">
      {presentaciones.map(p => <li>{p}</li>)}
    </ul>
    <a href={orderLink} class="btn btn-outline" target="_blank" rel="noopener">
      <i class="fab fa-whatsapp" aria-hidden="true"></i> Pedir
    </a>
  </div>
</article>

<style>
  .product-card {
    flex: 1 1 280px;
    max-width: 340px;
    display: flex;
    flex-direction: column;
    background: var(--crema);
    border-radius: 24px;
    overflow: hidden;
  }

  .product-image {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .product-details {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 1.5rem;
  }

  h3 { font-size: 1.6rem; }

  p {
    color: var(--ciruela-suave);
    font-size: 0.975rem;
  }

  .sizes {
    display: flex;
    gap: 0.5rem;
    margin: 0 0 0.5rem;
    padding: 0;
    list-style: none;
  }

  .sizes li {
    padding: 0.2rem 0.75rem;
    border-radius: 999px;
    background: var(--rosa);
    font-size: 0.85rem;
    font-weight: 700;
  }

  .btn {
    margin-top: auto;
    width: 100%;
  }
</style>
