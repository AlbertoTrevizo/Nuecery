---
import { Image } from "astro:assets";
import Header from "../components/Header.astro";
import Presentations from "../components/Presentations.astro";
import Kitchen from "../components/Kitchen.astro";
import Locations from "../components/Locations.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import { WHATSAPP } from "../consts";
import heroImg from "../assets/images/nuez8.jpg";
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nuecery</title>
    <meta name="description" content="Nuez pecana seleccionada a mano en Cuauhtémoc, Chihuahua. Corazón, pedacería, granillo, granzón y garapiñada en 1 kg y 500 gr." />
    <link rel="icon" type="image/png" href="/images/nuecery-logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Karla:wght@400;600;700&display=swap" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
    <link rel="stylesheet" href="/styles/styles.css" />
  </head>
  <body>
    <Header />
    <main>
      <section class="hero">
        <div class="container hero-inner">
          <div class="hero-text">
            <h1>Nuez pecana seleccionada a mano</h1>
            <p>
              Nuez de la mejor calidad desde Cuauhtémoc, Chihuahua. Tostada a la perfección
              y lista para tu cocina en presentaciones de 1 kg y 500 gr.
            </p>
            <div class="hero-actions">
              <a href="#presentaciones" class="btn">Ver productos</a>
              <a href={WHATSAPP} class="btn btn-outline" target="_blank" rel="noopener">
                <i class="fab fa-whatsapp" aria-hidden="true"></i> Pedir por WhatsApp
              </a>
            </div>
          </div>
          <div class="hero-media">
            <Image
              src={heroImg}
              alt="Tazón de nuez pecana junto a un frasco de miel y flores"
              width={900} widths={[480, 900]}
              sizes="(max-width: 760px) 80vw, 440px"
              loading="eager"
              class="hero-photo"
            />
            <img src="/images/nuecery-logo.png" alt="" class="hero-seal" width="150" height="150" />
          </div>
        </div>
      </section>
      <Presentations />
      <Kitchen />
      <Locations />
      <Contact />
    </main>
    <Footer />
  </body>
</html>

<style>
  .hero { padding-block: clamp(3rem, 7vw, 6rem); overflow: hidden; }

  .hero-inner {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    align-items: center;
    gap: 3rem;
  }

  h1 {
    font-size: clamp(2.6rem, 6.5vw, 4.6rem);
    max-width: 11ch;
  }

  .hero-text p {
    max-width: 34rem;
    margin-top: 1.5rem;
    font-size: 1.15rem;
    color: var(--ciruela-suave);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.25rem;
  }

  .hero-media {
    position: relative;
    justify-self: center;
    width: min(100%, 440px);
  }

  /* círculo rosa detrás del arco, como la etiqueta de las bolsas */
  .hero-media::before {
    content: '';
    position: absolute;
    inset: 12% -18% -6% 18%;
    border-radius: 50%;
    background: var(--rosa);
  }

  .hero-photo {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 999px 999px 28px 28px;
  }

  .hero-seal {
    position: absolute;
    left: -2.5rem;
    bottom: 1.5rem;
    width: 150px;
    border-radius: 50%;
    transform: rotate(-10deg);
    box-shadow: 0 10px 24px rgba(77, 58, 64, 0.25);
  }

  @media (max-width: 760px) {
    .hero-inner { grid-template-columns: 1fr; }
    .hero-media { width: min(80%, 360px); margin-left: 2rem; }
    .hero-seal { width: 104px; left: -2rem; bottom: 1rem; }
  }
</style>
